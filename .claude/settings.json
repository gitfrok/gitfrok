{
  "permissions": {
    "allow": [
      "Bash(./scripts/apply-rulesets.sh check)",
      "Bash(./scripts/apply-rulesets.sh plan)"
    ],
    "deny": [
      "Bash(./scripts/apply-rulesets.sh apply)",
      "Bash(make rulesets-apply)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 && graphify hook-guard search || true"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 && graphify hook-guard read || true"
          }
        ]
      }
    ]
  }
}
