# URLs are relative on purpose: `../<repo>.git` resolves against whatever remote this super-repo
# was cloned from, so SSH and HTTPS clones both work without a per-developer rewrite. Pins are by
# commit (invariant 25); `branch` is what `git submodule update --remote` follows.
# See ADR-0027 and governance/docs/architecture/04-repository-topology.md.
[submodule "governance"]
	path = governance
	url = ../governance.git
	branch = main
[submodule "backend"]
	path = backend
	url = ../backend.git
	branch = main
[submodule "bff"]
	path = bff
	url = ../bff.git
	branch = main
[submodule "webfrontend"]
	path = webfrontend
	url = ../webfrontend.git
	branch = main
