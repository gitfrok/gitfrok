# Terragrunt's per-unit working copy and OpenTofu's provider cache. Both are regenerated.
.terragrunt-cache/
.terraform/
.terraform.lock.hcl

# Generated by root.hcl on every run — never a committed file.
backend.tf
provider.tf

# State never leaves GCS (ADR-0092 decision 6). If one of these ever appears, something ran with a
# local backend and the file is a secret.
*.tfstate
*.tfstate.*
*.tfplan
