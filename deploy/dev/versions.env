# Single source of truth for service image tags (local Minikube + version floor of record).
# See ADR-0023 (stack) and ADR-0024 (dev env).
POSTGRES_IMAGE=docker.io/library/postgres:18.4
VALKEY_IMAGE=docker.io/valkey/valkey:9.1.1
REDPANDA_IMAGE=docker.io/redpandadata/redpanda:v26.2.1
SEAWEEDFS_IMAGE=docker.io/chrislusf/seaweedfs:4.40
ZITADEL_IMAGE=ghcr.io/zitadel/zitadel:v4.16.2
# Login V2 UI — same version tag as the API, per the upstream Compose pack.
ZITADEL_LOGIN_IMAGE=ghcr.io/zitadel/zitadel-login:v4.16.2
# Init containers (zitadel db-wait) and the T-0003 hello smoke-test fixture.
BUSYBOX_IMAGE=docker.io/library/busybox:1.35.0

# First-party dev plane images (T-0021). Built and loaded into the cluster
# node by dev-up.sh (minikube image build); they are never published to an
# external registry in this environment — check-dev-images.sh exempts them from
# registry resolution for that reason. They are pinned in versions.env so the
# dev cluster and the record agree, and the same manifest is the one
# smoke-dev.sh asserts the cluster is running.
DATAPLANE_IMAGE=docker.io/gitfrok/dataplane-app:0.1.0
CONTROLPLANE_IMAGE=docker.io/gitfrok/controlplane-app:0.1.0
# The Git storage tier. Unlike the two planes it ships on a base carrying git,
# because its whole job is to execute git as a subprocess (ADR-0048).
GIT_STORAGED_IMAGE=docker.io/gitfrok/git-storaged:0.1.0
# The BFF and web frontend (T-0015). The web surface is only ever reached
# through the BFF (invariant 22); both images are first-party dev plane images
# built and loaded by dev-up.sh like the planes above.
BFF_IMAGE=docker.io/gitfrok/bff:0.1.0
WEBFRONTEND_IMAGE=docker.io/gitfrok/webfrontend:0.1.0

# The custody service (T-0040 AC5, ADR-0066): OpenBao, control-plane-side only,
# three-node Raft, Shamir quorum unseal. Pinned like any other third-party
# control-plane dependency (ADR-0034). v2.6.1 (released 2026-07-22) was the latest
# stable at pin time (2026-08-15). OpenBao maintains only its latest major, so the
# pin-and-upgrade cadence is an ongoing obligation (ADR-0066 decision 7) — 2.7 moves
# several built-in seals to plugins.
OPENBAO_IMAGE=docker.io/openbao/openbao:2.6.1

# KEDA autoscales the data plane on CI queue depth (T-0017 AC2). Its release
# manifest is applied from upstream rather than vendored (ADR-0039); this pins
# which release.
KEDA_VERSION=2.16.1

# Host tool floors (also in .tool-versions): go>=1.26  node>=26  tsc>=7  git>=2
# Local domain: *.gitsaas.test   TLS: mkcert wildcard   Cluster: Minikube (ingress+ingress-dns)
