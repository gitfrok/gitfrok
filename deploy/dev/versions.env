# Single source of truth for service image tags (local Minikube + version floor of record).
# See ADR-0023 (stack) and ADR-0024 (dev env).
POSTGRES_IMAGE=docker.io/library/postgres:18.4
VALKEY_IMAGE=docker.io/valkey/valkey:9.1.1
REDPANDA_IMAGE=docker.io/redpandadata/redpanda:v26.2.1
SEAWEEDFS_IMAGE=docker.io/chrislusf/seaweedfs:4.40
ZITADEL_IMAGE=ghcr.io/zitadel/zitadel:v4.16.2
# Init containers (zitadel db-wait) and the T-0003 hello smoke-test fixture.
BUSYBOX_IMAGE=docker.io/library/busybox:1.35.0

# First-party dev plane images (T-0021). Built and loaded into the cluster
# node by dev-up.sh (minikube image build); they are never published to an
# external registry in this environment — check-dev-images.sh exempts them from
# registry resolution for that reason. They are pinned in versions.env so the
# dev cluster and the record agree, and the same manifest is the one
# smoke-dev.sh asserts the cluster is running.
DATAPLANE_IMAGE=docker.io/gitfrok/dataplane-app:0.1.0
CONTROLPLANE_IMAGE=docker.io/gitfrok/controlplane-app:0.1.0

# Host tool floors (also in .tool-versions): go>=1.26  node>=26  tsc>=7  git>=2
# Local domain: *.gitsaas.test   TLS: mkcert wildcard   Cluster: Minikube (ingress+ingress-dns)
